# SentinelFlow Environment Configuration

# Flask Secret Key for Session Signing
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# App Server Port & Debug
PORT=5000
FLASK_DEBUG=0

# Database Connection (Optional Postgres for Heroku/Render free tiers; defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelflow

# Initial Admin Password (seeded on first boot)
ADMIN_PASSWORD=SentinelAdmin2026!
